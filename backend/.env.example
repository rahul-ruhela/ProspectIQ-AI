# ============================================================================
# ProspectIQ AI - backend configuration
# Copy to .env and fill in. Never commit the filled-in file.
# ============================================================================

# --- application ---
APP_NAME=ProspectIQ AI
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- database ---
# Docker Compose overrides this with the postgres service host.
DATABASE_URL=postgresql+psycopg://prospectiq:prospectiq@localhost:5432/prospectiq

# --- redis / celery ---
REDIS_URL=redis://localhost:6379/0

# --- security (REQUIRED: replace both before any real deployment) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in development: it is derived from SECRET_KEY.
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- bootstrap admin (optional; created by the seeder on first run) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Administrator
SEED_ORG_NAME=ProspectIQ

# --- LLM (optional) ---
# Without a key the platform still runs: reports fall back to the rules engine
# and no narrative synthesis is performed. No data is ever invented either way.
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_CHEAP_MODEL=claude-haiku-4-5
LLM_SMART_MODEL=claude-opus-5

# --- discovery connectors (at least one is needed to discover companies) ---
# OpenStreetMap needs no key and returns structured business records (name, website,
# phone, address) for mapped verticals. Search connectors add reach beyond OSM.
# Preference order for search: serper > google_cse > searxng > duckduckgo.
SERPER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SEARXNG_URL=
ENABLE_DUCKDUCKGO=true
ENABLE_OPENSTREETMAP=true

# --- crawling ---
HTTP_USER_AGENT=ProspectIQ-AI/1.0 (+https://prospectiq.ai/bot)
HTTP_TIMEOUT_SECONDS=20
CRAWL_MAX_PAGES_PER_SITE=12
CRAWL_DELAY_SECONDS=1.0
RESPECT_ROBOTS_TXT=true
# Requires `playwright install chromium` in the image/host.
ENABLE_PLAYWRIGHT=false

# --- guardrails ---
MAX_COMPANIES_PER_JOB=250
DEFAULT_CAMPAIGN_BUDGET_USD=25
